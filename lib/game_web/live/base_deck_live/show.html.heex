<.header>
  Base deck {@base_deck.id}
  <:subtitle>This is a base_deck record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/basedecks/#{@base_deck}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit base_deck</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Name">{@base_deck.name}</:item>
</.list>

<.back navigate={~p"/admin/basedecks"}>Back to basedecks</.back>

<.modal :if={@live_action == :edit} id="base_deck-modal" show on_cancel={JS.patch(~p"/admin/basedecks/#{@base_deck}")}>
  <.live_component
    module={GameWeb.BaseDeckLive.FormComponent}
    id={@base_deck.id}
    title={@page_title}
    action={@live_action}
    base_deck={@base_deck}
    patch={~p"/admin/basedecks/#{@base_deck}"}
  />
</.modal>
