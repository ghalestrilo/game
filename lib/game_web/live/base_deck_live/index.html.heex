<.header>
  Listing Basedecks
  <:actions>
    <.link patch={~p"/admin"}>
      <.button>Admin</.button>
    </.link>
    <.link patch={~p"/admin/basedecks/new"}>
      <.button>New Base deck</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="basedecks"
  rows={@streams.basedecks}
  row_click={fn {_id, base_deck} -> JS.navigate(~p"/admin/basedecks/#{base_deck}") end}
>
  <:col :let={{_id, base_deck}} label="Name">{base_deck.name}</:col>
  <:action :let={{_id, base_deck}}>
    <div class="sr-only">
      <.link navigate={~p"/admin/basedecks/#{base_deck}"}>Show</.link>
    </div>
    <.link patch={~p"/admin/basedecks/#{base_deck}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, base_deck}}>
    <.link
      phx-click={JS.push("delete", value: %{id: base_deck.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="base_deck-modal"
  show
  on_cancel={JS.patch(~p"/admin/basedecks")}
>
  <.live_component
    module={GameWeb.BaseDeckLive.FormComponent}
    id={@base_deck.id || :new}
    title={@page_title}
    action={@live_action}
    base_deck={@base_deck |> Game.Repo.preload(:base_deck_cards)}
    patch={~p"/admin/basedecks"}
  />
</.modal>
