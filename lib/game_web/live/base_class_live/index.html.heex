<.header>
  Listing Characters
  <:actions>
    <.link patch={~p"/admin"}>
      <.button>Admin</.button>
    </.link>
    <.link patch={~p"/admin/base_classes/new"}>
      <.button>New Character</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="base_classes"
  rows={@streams.base_classes}
  row_click={fn {_id, base_class} -> JS.navigate(~p"/admin/base_classes/#{base_class}") end}
>
  <:col :let={{_id, base_class}} label="Class">{base_class.class}</:col>
  <:col :let={{_id, base_class}} label="Base hp">{base_class.base_hp}</:col>
  <:col :let={{_id, base_class}} label="Base ap">{base_class.base_ap}</:col>
  <:col :let={{_id, base_class}} label="Base movement">{base_class.base_movement}</:col>
  <:action :let={{_id, base_class}}>
    <div class="sr-only">
      <.link navigate={~p"/admin/base_classes/#{base_class}"}>Show</.link>
    </div>
    <.link patch={~p"/admin/base_classes/#{base_class}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, base_class}}>
    <.link
      phx-click={JS.push("delete", value: %{id: base_class.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="base_class-modal"
  show
  on_cancel={JS.patch(~p"/admin/base_classes")}
>
  <.live_component
    module={GameWeb.BaseClassLive.FormComponent}
    id={@base_class.id || :new}
    title={@page_title}
    action={@live_action}
    base_class={@base_class}
    patch={~p"/admin/base_classes"}
  />
</.modal>
