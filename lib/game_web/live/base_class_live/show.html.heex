<.header>
  Character {@base_class.id}
  <:subtitle>This is a base_class record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/base_classes/#{@base_class}/show/edit"} phx-click={JS.push_focus()}>
    <.button>Edit base_class</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Class">{@base_class.class}</:item>
  <:item title="Base hp">{@base_class.base_hp}</:item>
  <:item title="Base ap">{@base_class.base_ap}</:item>
  <:item title="Base movement">{@base_class.base_movement}</:item>
</.list>

<.back navigate={~p"/admin/base_classes"}>Back to base_classes</.back>

<.modal
  :if={@live_action == :edit}
  id="base_class-modal"
  show
  on_cancel={JS.patch(~p"/admin/base_classes/#{@base_class}")}
>
  <.live_component
    module={GameWeb.BaseClassLive.FormComponent}
    id={@base_class.id}
    title={@page_title}
    action={@live_action}
    base_class={@base_class}
    patch={~p"/admin/Base Class/#{@base_class}"}
  />
</.modal>
