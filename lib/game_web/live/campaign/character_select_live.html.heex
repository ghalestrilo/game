<div class="flex flex-col h-screen p-8">
  <.header>
    Select Your Character
    <:subtitle>Choose a character to begin your campaign</:subtitle>
  </.header>

  <div class="mt-8 mb-6">
    <label for="player-name" class="block text-sm font-medium mb-2">
      Player Name
    </label>
    <form phx-change="update_player_name">
      <input
        type="text"
        id="player-name"
        name="player_name"
        value={@campaign.player.name}
        placeholder="Enter your name"
        class="w-full md:w-1/2 px-4 py-2 border border-zinc-300 dark:border-zinc-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:focus:ring-zinc-400 bg-white dark:bg-zinc-900"
      />
    </form>
  </div>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <%= for base_class <- @base_classes do %>
      <div
        class="border border-zinc-300 dark:border-zinc-700 rounded-lg p-6 hover:border-zinc-500 dark:hover:border-zinc-400 cursor-pointer transition-colors"
        phx-click="select_character"
        phx-value-id={base_class.id}
      >
        <h3 class="text-xl font-bold capitalize mb-4"><%= base_class.class %></h3>
        <div class="space-y-2">
          <div class="flex justify-between">
            <span class="text-zinc-600 dark:text-zinc-400">HP:</span>
            <span class="font-semibold"><%= base_class.base_hp %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-600 dark:text-zinc-400">AP:</span>
            <span class="font-semibold"><%= base_class.base_ap %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-zinc-600 dark:text-zinc-400">Movement:</span>
            <span class="font-semibold"><%= base_class.base_movement %></span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <%= if @campaign.character do %>
    <div class="mt-8 p-4 bg-green-100 dark:bg-green-900 rounded-lg flex flex-col gap-4">
      <p class="text-center font-semibold">
        <%= if @campaign.player.name != "" do %>
          <%= @campaign.player.name %> selected: <%= @campaign.character.name %>
        <% else %>
          Selected: <%= @campaign.character.name %>
        <% end %>
      </p>
      <div class="text-center">
        <.link
          navigate={~p"/campaign/play"}
          class="inline-block px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-lg transition-colors"
        >
          Start Campaign
        </.link>
      </div>
    </div>
  <% end %>

  <div class="mt-8">
    <.link navigate={~p"/"} class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100">
      &larr; Back to Home
    </.link>
  </div>
</div>
