<.header>
  Listing Basecards
  <:actions>
    <.link patch={~p"/admin/basecards/new"}>
      <.button>New Base card</.button>
    </.link>
  </:actions>
</.header>

<.table
  id="basecards"
  rows={@streams.basecards}
  row_click={fn {_id, base_card} -> JS.navigate(~p"/admin/basecards/#{base_card}") end}
>
  <:col :let={{_id, base_card}} label="Name">{base_card.name}</:col>
  <:col :let={{_id, base_card}} label="Effects">{inspect(base_card.effects)}</:col>
  <:col :let={{_id, base_card}} label="Ap">{base_card.ap}</:col>
  <:col :let={{_id, base_card}} label="Headline">{base_card.headline}</:col>
  <:col :let={{_id, base_card}} label="Rarity">{base_card.rarity}</:col>
  <:action :let={{_id, base_card}}>
    <div class="sr-only">
      <.link navigate={~p"/admin/basecards/#{base_card}"}>Show</.link>
    </div>
    <.link patch={~p"/admin/basecards/#{base_card}/edit"}>Edit</.link>
  </:action>
  <:action :let={{id, base_card}}>
    <.link
      phx-click={JS.push("delete", value: %{id: base_card.id}) |> hide("##{id}")}
      data-confirm="Are you sure?"
    >
      Delete
    </.link>
  </:action>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="base_card-modal"
  show
  on_cancel={JS.patch(~p"/admin/basecards")}
>
  <.live_component
    module={GameWeb.BaseCardLive.FormComponent}
    id={@base_card.id || :new}
    title={@page_title}
    action={@live_action}
    base_card={@base_card}
    patch={~p"/admin/basecards"}
  />
</.modal>
