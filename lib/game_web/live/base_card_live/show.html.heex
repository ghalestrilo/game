<.header>
  Base card {@base_card.id}
  <:subtitle>This is a base_card record from your database.</:subtitle>
  <:actions>
    <.link patch={~p"/admin/basecards/#{@base_card}/show/edit"} phx-click={JS.push_focus()}>
      <.button>Edit base_card</.button>
    </.link>
  </:actions>
</.header>

<.list>
  <:item title="Name">{@base_card.name}</:item>
  <:item title="Effects">{@base_card.effects}</:item>
  <:item title="Ap">{@base_card.ap}</:item>
  <:item title="Headline">{@base_card.headline}</:item>
  <:item title="Rarity">{@base_card.rarity}</:item>
</.list>

<.back navigate={~p"/admin/basecards"}>Back to basecards</.back>

<.modal
  :if={@live_action == :edit}
  id="base_card-modal"
  show
  on_cancel={JS.patch(~p"/admin/basecards/#{@base_card}")}
>
  <.live_component
    module={GameWeb.BaseCardLive.FormComponent}
    id={@base_card.id}
    title={@page_title}
    action={@live_action}
    base_card={@base_card}
    patch={~p"/admin/basecards/#{@base_card}"}
  />
</.modal>
