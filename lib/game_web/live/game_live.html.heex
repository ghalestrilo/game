<%= if @game_state do %>
  <%= if @game_state.current_view == :combat do %>
    <.live_component
      module={GameWeb.CombatLive}
      id="combat-view"
      game_state={@game_state}
      action_log={@action_log}
      current_player={nil}
    />
  <% end %>

  <%= if @game_state.current_view == :shop do %>
    <.live_component
      module={GameWeb.ShopLive}
      id="shop-view"
      game_state={@game_state}
    />
  <% end %>
<% end %>
